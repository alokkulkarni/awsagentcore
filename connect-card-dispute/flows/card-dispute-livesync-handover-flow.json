  "Actions": [
    {
      "Identifier": "CardDisputeAssistant",
      "Type": "ConnectParticipantWithAgenticCX",
      "Parameters": {
        "AgentConfiguration": {
          "WorkspaceId": "55c49fa0-22f3-4dd3-823d-e353f4aee139",
          "ContextVariables": {
            "entry": "$.Attributes.entry",
            "contactId": "$.ContactId",
            "firstName": "$.Attributes.preferredName",
            "verification": "$.Attributes.authStatus",
            "handoverSummary": "$.Attributes.handoverSummary",
            "screenCode": "$.Attributes.screenCode"
          },
          "ApplicationId": "CHOOSE-IN-THE-BLOCK",
          "Alias": "CHOOSE-IN-THE-BLOCK"
        },
        "SpeechRecognitionConfiguration": {
          "SpeechRecognitionEngine": "AMAZON_AGENTIC_VOICE"
        },
        "AudioFillerConfiguration": {
          "Enabled": true,
          "AudioType": "TYPING_QUIET_QWERTY",
          "StartDelayInMilliseconds": 2500,
          "MinimumPlayDurationInMilliseconds": 3000,
          "ResponseDeliveryDelayInMilliseconds": 500
        },
        "IdleChatTimeoutSeconds": 600
      },
      "Transitions": {
        "NextAction": "AssistantUnavailable",
        "Conditions": [
          {
            "NextAction": "CheckTopic",
            "Condition": {
              "Operator": "Equals",
              "Operands": [
                "Escalation"
              ]
            }
          }
        ],
        "Errors": [
          {
            "NextAction": "AssistantUnavailable",
            "ErrorType": "NoMatchingError"
          },
          {
            "NextAction": "AssistantUnavailable",
            "ErrorType": "NoMatchingCondition"
          },
          {
            "NextAction": "Disconnect",
            "ErrorType": "InputTimeLimitExceeded"
          }
        ]
      }
    },
    {
      "Identifier": "CheckTopic",
      "Type": "Compare",
      "Parameters": {
        "ComparisonValue": "$.AgenticCX.ContextVariables.topicCategory"
      },
      "Transitions": {
        "NextAction": "EscalatedTopicUnknown",
        "Conditions": [
          {
            "NextAction": "Escalated",
            "Condition": {
              "Operator": "Equals",
              "Operands": [
                "fraud_security"
              ]
            }
          },
          {
            "NextAction": "Escalated",
            "Condition": {
              "Operator": "Equals",
              "Operands": [
                "debit_card"
              ]
            }
          },
          {
            "NextAction": "Escalated",
            "Condition": {
              "Operator": "Equals",
              "Operands": [
                "credit_card"
              ]
            }
          }
        ],
        "Errors": [
