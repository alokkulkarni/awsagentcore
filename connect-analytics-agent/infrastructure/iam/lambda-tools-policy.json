{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ConnectAnalyticsAccess",
      "Effect": "Allow",
      "Action": [
        "connect:GetCurrentMetricData",
        "connect:GetCurrentUserData",
        "connect:GetMetricData",
        "connect:GetMetricDataV2",
        "connect:SearchContacts",
        "connect:DescribeContact",
        "connect:GetContactAttributes",
        "connect:ListContactAnalysisSegments",
        "connect:ListRealtimeContactAnalysisSegmentsV2",
        "connect:DescribeUser",
        "connect:ListUsers",
        "connect:ListQueues",
        "connect:DescribeQueue",
        "connect:ListRoutingProfiles"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ContactLensAccess",
      "Effect": "Allow",
      "Action": [
        "connect-contact-lens:ListRealtimeContactAnalysisSegments"
      ],
      "Resource": "*"
    },
    {
      "Sid": "RecordingsBucketAccessRestrictInProduction",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CloudWatchLogsWrite",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CloudWatchLogsRead",
      "Effect": "Allow",
      "Action": [
        "logs:DescribeLogGroups",
        "logs:DescribeLogStreams",
        "logs:FilterLogEvents",
        "logs:GetLogEvents",
        "logs:StartQuery",
        "logs:StopQuery",
        "logs:GetQueryResults",
        "logs:GetLogRecord",
        "logs:GetLogGroupFields"
      ],
      "Resource": "*"
    }
  ]
}
