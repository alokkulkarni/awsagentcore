# Required for cloud deployment
AWS_REGION=us-east-1
CONNECT_INSTANCE_ID=your-connect-instance-id-here

# Optional - defaults shown
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5
STACK_SUFFIX=prod

# Local Docker — AWS credentials
# No need to set these manually. The deploy.sh local command mounts your
# ~/.aws directory into the container, so your existing AWS CLI profiles
# (including SSO) are used automatically.
#
# Optionally specify a named profile (defaults to "default"):
# AWS_PROFILE=my-connect-profile
