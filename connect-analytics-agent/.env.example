# Required for cloud deployment
AWS_REGION=us-east-1
CONNECT_INSTANCE_ID=your-connect-instance-id-here

# Optional - defaults shown
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5
STACK_SUFFIX=prod

# For local Docker with real AWS (not needed in MOCK_MODE)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Set to false to use real AWS services locally
MOCK_MODE=true
