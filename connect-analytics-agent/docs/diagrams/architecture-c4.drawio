<mxfile host="app.diagrams.net">
  <diagram id="c4-context" name="C4 L1 - System Context">
    <mxGraphModel adaptiveColors="auto" grid="1" gridSize="10">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t" value="&lt;b&gt;C4 Level 1 — System Context: Connect Analytics Agent&lt;/b&gt;" style="text;html=1;fontSize=18;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="15" width="700" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="p1" value="&lt;b&gt;Contact-Centre Supervisor / Analyst&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;Monitors live queues and agents,&#xa;analyses contacts, asks the AI assistant&#xa;questions in natural language" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="480" y="70" width="280" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="sys" value="&lt;b&gt;Connect Analytics Agent&lt;/b&gt;&lt;br&gt;[Software System]&lt;br&gt;Real-time + historical contact-centre&#xa;analytics dashboard with an AI chat agent&#xa;(Strands + Bedrock) over Amazon Connect data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="480" y="270" width="280" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="x1" value="&lt;b&gt;Amazon Connect + Contact Lens&lt;/b&gt;&lt;br&gt;[External System]&lt;br&gt;Contact-centre platform: metrics,&#xa;contacts, users, flows, transcripts,&#xa;recordings, CCP softphone" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="80" y="275" width="260" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="x4" value="&lt;b&gt;EventBridge + SQS&lt;/b&gt;&lt;br&gt;[External System]&lt;br&gt;Streams Connect contact/agent&#xa;events for live activity views" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="900" y="275" width="260" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="x2" value="&lt;b&gt;Amazon Bedrock&lt;/b&gt;&lt;br&gt;[External System]&lt;br&gt;Claude LLM for tool orchestration,&#xa;answer formatting and theme extraction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="480" y="510" width="260" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="x3" value="&lt;b&gt;Amazon Cognito&lt;/b&gt;&lt;br&gt;[External System]&lt;br&gt;User pool issuing JWTs;&#xa;API Gateway authorizer (cloud mode)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="900" y="510" width="260" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="ce1" value="views dashboards, chats with agent&#xa;[HTTPS]" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="p1" target="sys" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ce2" value="queries analytics APIs,&#xa;monitor/barge [SigV4 / boto3]" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="sys" target="x1" parent="1">
