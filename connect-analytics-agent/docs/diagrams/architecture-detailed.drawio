        <mxCell id="e7" value="MCP / SSE (SigV4)" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" source="agentl" target="gw" parent="1">
