<mxfile host="app.diagrams.net">
  <diagram id="cloud-arch" name="Cloud Architecture">
    <mxGraphModel adaptiveColors="auto" grid="1" gridSize="10">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;Amazon Connect Analytics Agent — Cloud Deployment (deploy.sh deploy)&lt;/b&gt;" style="text;html=1;fontSize=18;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="15" width="820" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="user" value="&lt;b&gt;Supervisor / Analyst&lt;/b&gt;&lt;br&gt;Contact-centre operations" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="235" width="40" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="browser" value="&lt;b&gt;Browser&lt;/b&gt;&lt;br&gt;React 18 SPA (Vite build)&lt;br&gt;+ hidden Connect CCP iframe&lt;br&gt;(amazon-connect-streams)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="170" y="225" width="190" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="aws" value="AWS Cloud" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontStyle=1;fillColor=none;strokeColor=#232F3E;dashed=1;container=0;fontSize=13;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="420" y="60" width="1460" height="800" as="geometry"/>
        </mxCell>
        <mxCell id="s3web" value="&lt;b&gt;S3 frontend bucket&lt;/b&gt;&lt;br&gt;PRIVATE — Block Public Access ON&lt;br&gt;CloudFront Origin Access Control&lt;br&gt;(security fix)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F2E6;strokeColor=#277116;" vertex="1" parent="1">
          <mxGeometry x="460" y="90" width="200" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="cf" value="&lt;b&gt;Amazon CloudFront&lt;/b&gt;&lt;br&gt;SPA CDN + /api/* behaviour&lt;br&gt;redirect-to-https" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2E7F7;strokeColor=#8C4FFF;" vertex="1" parent="1">
          <mxGeometry x="460" y="230" width="200" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="cognito" value="&lt;b&gt;Amazon Cognito&lt;/b&gt;&lt;br&gt;User pool + SPA client (SRP only)&lt;br&gt;12-char password policy&lt;br&gt;JWT authorizer on query/metrics&lt;br&gt;(security fix — API_AUTH=cognito)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F2E6;strokeColor=#277116;" vertex="1" parent="1">
          <mxGeometry x="740" y="80" width="220" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="apigw" value="&lt;b&gt;API Gateway (REST, regional)&lt;/b&gt;&lt;br&gt;POST /api/query&lt;br&gt;GET /api/health, /api/metrics&lt;br&gt;AWS_PROXY integration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2E7F7;strokeColor=#8C4FFF;" vertex="1" parent="1">
          <mxGeometry x="740" y="225" width="220" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="gw" value="&lt;b&gt;AgentCore Gateway (optional)&lt;/b&gt;&lt;br&gt;MCP over SSE, SigV4&lt;br&gt;falls back to direct Lambda&lt;br&gt;when unavailable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1040" y="80" width="220" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="agentl" value="&lt;b&gt;Agent Lambda (Python 3.12)&lt;/b&gt;&lt;br&gt;handler.py + agent_core.py&lt;br&gt;Strands Agent, 4-tier execution:&lt;br&gt;1 Gateway (MCP)  2 Direct Lambda&lt;br&gt;3 In-process  4 Conversational" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE8CC;strokeColor=#D79B00;" vertex="1" parent="1">
          <mxGeometry x="1040" y="215" width="220" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="bedrock" value="&lt;b&gt;Amazon Bedrock&lt;/b&gt;&lt;br&gt;Claude (BEDROCK_MODEL_ID)&lt;br&gt;converse + model fallback list" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="1040" y="430" width="220" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="sess" value="&lt;b&gt;Session store (optional)&lt;/b&gt;&lt;br&gt;DynamoDB (SESSION_TABLE_NAME)&lt;br&gt;+ S3 overflow &amp;gt; 300 KB&lt;br&gt;SESSION_BACKEND=dynamodb" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;boundedLbl=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="720" y="430" width="200" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="tools" value="&lt;b&gt;9 Tool Lambdas (Python 3.12, boto3)&lt;/b&gt;&lt;br&gt;realtime-metrics · historical-metrics&lt;br&gt;agent-states · search-contacts&lt;br&gt;contact-detail · transcript&lt;br&gt;keyword-search · recording-url&lt;br&gt;contact-flow-events&lt;br&gt;&lt;i&gt;IAM scoped to connect-analytics-* (fix)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE8CC;strokeColor=#D79B00;" vertex="1" parent="1">
          <mxGeometry x="1340" y="195" width="240" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="connect" value="&lt;b&gt;Amazon Connect&lt;/b&gt;&lt;br&gt;metrics · users · contacts&lt;br&gt;queues · flows · monitor_contact&lt;br&gt;+ Contact Lens transcripts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="1340" y="430" width="240" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="cw" value="&lt;b&gt;CloudWatch Logs&lt;/b&gt;&lt;br&gt;Connect flow logs&lt;br&gt;(Logs Insights queries)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="1660" y="120" width="180" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="s3rec" value="&lt;b&gt;S3 recordings bucket&lt;/b&gt;&lt;br&gt;pre-signed GET URLs (max 12h)&lt;br&gt;&lt;i&gt;s3:GetObject scoped to&lt;br&gt;amazon-connect-* (fix)&lt;/i&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;boundedLbl=1;" vertex="1" parent="1">
          <mxGeometry x="1660" y="240" width="160" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="iamnote" value="&lt;b&gt;Security hardening applied&lt;/b&gt;&lt;br&gt;• Cognito JWT authorizer on /api/query + /api/metrics (was NONE)&lt;br&gt;• Private S3 + OAC (was public website bucket over HTTP)&lt;br&gt;• IAM: lambda:InvokeFunction + s3:GetObject de-wildcarded&lt;br&gt;• No PII/event payloads in CloudWatch logs&lt;br&gt;• npm/pip dependencies: 0 known vulnerabilities" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#E6F2E6;strokeColor=#277116;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="460" y="620" width="430" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="flow1" value="&lt;b&gt;Chat request path&lt;/b&gt;&lt;br&gt;Browser → CloudFront /api/query → API Gateway (JWT) → Agent Lambda&lt;br&gt;→ tier 1: Strands + MCP via AgentCore Gateway → Tool Lambda&lt;br&gt;→ or tier 2: direct lambda:Invoke → Connect APIs&lt;br&gt;→ Bedrock formats the answer → response to browser" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#FFF9E6;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="940" y="620" width="480" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="user" target="browser" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="HTTPS 443" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="browser" target="cf" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="OAC (SigV4, HTTPS)" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" source="cf" target="s3web" parent="1">
          <mxGeometry relative="1" as="geometry"/>
