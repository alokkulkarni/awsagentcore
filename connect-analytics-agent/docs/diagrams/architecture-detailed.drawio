        </mxCell>
        <mxCell id="e9" value="lambda:Invoke (direct mode)" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="agentl" target="tools" parent="1">
