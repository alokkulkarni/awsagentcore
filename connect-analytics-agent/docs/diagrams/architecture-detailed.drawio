        <mxCell id="e8" value="gateway targets" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="gw" target="tools" parent="1">
