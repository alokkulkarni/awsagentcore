        <mxCell id="e5" value="validate JWT" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" source="apigw" target="cognito" parent="1">
