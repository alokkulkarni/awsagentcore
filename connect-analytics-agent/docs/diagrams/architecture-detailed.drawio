  <diagram id="local-arch" name="Local Architecture (Docker)">
    <mxGraphModel adaptiveColors="auto" grid="1" gridSize="10">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="ltitle" value="&lt;b&gt;Amazon Connect Analytics Agent — Local Deployment (deploy.sh local, Docker Compose)&lt;/b&gt;" style="text;html=1;fontSize=18;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="15" width="900" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="luser" value="&lt;b&gt;Developer /&lt;br&gt;Supervisor&lt;/b&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="235" width="40" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="lbrowser" value="&lt;b&gt;Browser&lt;/b&gt;&lt;br&gt;http://localhost:5274&lt;br&gt;React SPA + CCP iframe&lt;br&gt;SSE consumers (scans)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="170" y="210" width="180" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="dockerbox" value="Docker Compose (ports published on 127.0.0.1 only — security fix)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontStyle=1;fillColor=none;strokeColor=#0B5394;dashed=1;fontSize=13;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="420" y="60" width="760" height="700" as="geometry"/>
        </mxCell>
        <mxCell id="vite" value="&lt;b&gt;frontend container&lt;/b&gt;&lt;br&gt;node:20-alpine, USER node (fix)&lt;br&gt;Vite dev server :5274&lt;br&gt;allowedHosts allow-list (fix)&lt;br&gt;proxy /api → agent:8100" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="460" y="200" width="220" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="fastapi" value="&lt;b&gt;agent container — FastAPI :8100&lt;/b&gt;&lt;br&gt;python:3.12-slim, USER appuser (fix)&lt;br&gt;local_server.py (~55 routes)&lt;br&gt;CORS allow-list · security headers&lt;br&gt;rate limiting · MOCK_MODE toggle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE8CC;strokeColor=#D79B00;" vertex="1" parent="1">
          <mxGeometry x="770" y="200" width="260" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="scans" value="&lt;b&gt;Background modules&lt;/b&gt;&lt;br&gt;startup_scan (resource discovery)&lt;br&gt;theme_scan (Bedrock themes)&lt;br&gt;disconnect_reasons (CTR analysis)&lt;br&gt;eventbridge_listener (SQS poll)&lt;br&gt;hours_of_operation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="460" y="390" width="240" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="agcore" value="&lt;b&gt;ConnectAnalyticsAgent&lt;/b&gt;&lt;br&gt;agent_core.py · regex tool router&lt;br&gt;LocalToolInvoker (in-process)&lt;br&gt;Bedrock response formatter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE8CC;strokeColor=#D79B00;" vertex="1" parent="1">
          <mxGeometry x="770" y="390" width="260" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="ltools" value="&lt;b&gt;tools/* handlers (in-process import)&lt;/b&gt;&lt;br&gt;9 gateway tools + bot_metrics&lt;br&gt;+ force_logout (API-only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE8CC;strokeColor=#D79B00;" vertex="1" parent="1">
          <mxGeometry x="770" y="550" width="260" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="vols" value="&lt;b&gt;Volumes&lt;/b&gt;&lt;br&gt;~/.aws → /home/appuser/.aws (ro)&lt;br&gt;agent_data → /app/data&lt;br&gt;(sessions.db SQLite,&lt;br&gt;discovered_resources.json)" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;boundedLbl=1;" vertex="1" parent="1">
          <mxGeometry x="460" y="590" width="180" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="lawsbox" value="AWS (live mode — MOCK_MODE=false)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontStyle=1;fillColor=none;strokeColor=#232F3E;dashed=1;fontSize=13;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1240" y="60" width="360" height="700" as="geometry"/>
        </mxCell>
        <mxCell id="lbedrock" value="&lt;b&gt;Amazon Bedrock&lt;/b&gt;&lt;br&gt;Claude converse&lt;br&gt;(chat formatting + theme scan)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="1280" y="110" width="260" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="lconnect" value="&lt;b&gt;Amazon Connect&lt;/b&gt;&lt;br&gt;+ Contact Lens&lt;br&gt;+ Lex V2 bot metrics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="1280" y="240" width="260" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="lcw" value="&lt;b&gt;CloudWatch Logs&lt;/b&gt;&lt;br&gt;flow logs · S3 recordings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="1280" y="380" width="260" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="leb" value="&lt;b&gt;EventBridge rule → SQS queue&lt;/b&gt;&lt;br&gt;Connect Contact + Agent events&lt;br&gt;(deploy.sh setup-eventbridge)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="1280" y="500" width="260" height="90" as="geometry"/>
