# ─── Amazon Connect ───────────────────────────────────────────────────────────
CONNECT_INSTANCE_ID=f969d4b4-f716-4974-a325-bb7899f2f293
CONNECT_REGION=eu-west-2

# Identify the contact flow either by ID or by name — one of these is required.
# If only the name is set, the evaluator will auto-discover the ID via ListContactFlows.
# CONNECT_CONTACT_FLOW_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
CONNECT_CONTACT_FLOW_NAME="conversation bot flow"

# ─── Amazon Connect — Voice / WebRTC channel ──────────────────────────────────
# Strongly recommended for --channel voice. If omitted, evaluator falls back to
# CONNECT_CONTACT_FLOW_NAME / CONNECT_CONTACT_FLOW_ID, which often causes voice
# runs to connect but receive no inbound audio when that flow is chat-only.
# CONNECT_VOICE_FLOW_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# CONNECT_VOICE_FLOW_NAME="conversation bot voice flow"

# ─── Amazon Polly — TTS for voice evaluation ─────────────────────────────────
# Voice used for the synthetic customer's speech.
# Brian = British English male neural voice (recommended for UK banking personas).
# Full list: https://docs.aws.amazon.com/polly/latest/dg/voicelist.html
POLLY_VOICE_ID=Brian
# Region for Polly calls. Defaults to CONNECT_REGION if not set.
# POLLY_REGION=eu-west-2

# ─── Amazon Transcribe Streaming — STT for voice evaluation ──────────────────
# Region for Transcribe Streaming. Defaults to CONNECT_REGION if not set.
# TRANSCRIBE_REGION=eu-west-2

# ─── Voice timeout settings ──────────────────────────────────────────────────
# Seconds to wait for ARIA's voice response before timing out.
VOICE_RESPONSE_TIMEOUT=45
# Seconds of silence (no new Transcribe results) that marks end of ARIA's utterance.
VOICE_SILENCE_TIMEOUT=3
# Prefer TURN relay ICE candidates over direct host/srflx (recommended for
# headless runners and restrictive NAT/firewall environments).
VOICE_PREFER_RELAY=0

# ─── Bedrock LLM Judge ────────────────────────────────────────────────────────
# Model used for LLM-as-judge evaluation (cross-region prefix required for eu-west-2)
JUDGE_MODEL_ID=eu.anthropic.claude-sonnet-4-5-20250929-v1:0
# Optional cheaper model for LLM-judge evaluation (e.g. Haiku = ~20x cheaper than Sonnet).
# If unset, JUDGE_MODEL_ID is used for everything.
# JUDGE_MODEL_ID_LIGHT=eu.anthropic.claude-haiku-4-5-20251014-v1:0
BEDROCK_REGION=eu-west-2

# ─── Evaluation run config ────────────────────────────────────────────────────
# Synthetic customer ID injected into Connect chat attributes
EVAL_CUSTOMER_ID=CUST-001
# Full name of the customer — used in all scenario personas and LLM judge goals.
# Set this to match the name stored in ARIA's backend for EVAL_CUSTOMER_ID.
EVAL_CUSTOMER_NAME=James Wilson
# Display name shown in the Connect transcript
EVAL_DISPLAY_NAME=ARIAEvaluatorBot
# How long each chat session stays open (minutes)
EVAL_CHAT_DURATION_MINUTES=60
# Seconds to wait for ARIA to respond before marking TIMEOUT (chat channel)
EVAL_RESPONSE_TIMEOUT_SECONDS=30
# Where to write the HTML and JSON report
EVAL_REPORT_OUTPUT_DIR=./reports

# ─── AgentCore (for registering evaluator configs) ────────────────────────────
AGENTCORE_REGION=eu-west-2
AWS_ACCOUNT_ID=<your-aws-account-id>

# Seconds without a WebSocket message before adapter reconnects
WEBSOCKET_IDLE_TIMEOUT_SECONDS=120
