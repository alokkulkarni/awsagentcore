{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Testcontainers skill configuration",
  "type": "object",
  "required": ["project_path", "scan", "containers", "test_placement", "shared_containers", "reuse_containers", "patch_ci", "ci_provider"],
  "properties": {
    "project_path": {"type": "string"},
    "confirmed_scan": {"type": "boolean"},
    "docker_enabled": {"type": "boolean"},
    "use_testcontainers_cloud": {"type": "boolean"},
    "scan": {
      "type": "object",
      "required": ["language", "build_tool", "test_framework", "dependencies", "env_vars", "ci_files", "has_docker"],
      "properties": {
        "language": {"type": "string"},
        "version": {"type": "string"},
        "build_tool": {"type": "string"},
        "framework": {"type": "string"},
        "test_framework": {"type": "string"},
        "dependencies": {"type": "array", "items": {"type": "string"}},
        "env_vars": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["file", "key", "service"],
            "properties": {
              "file": {"type": "string"},
              "key": {"type": "string"},
              "value": {"type": "string"},
              "service": {"type": "string"}
            }
          }
        },
        "ci_files": {"type": "array", "items": {"type": "string"}},
        "has_docker": {"type": "boolean"}
      }
    },
    "containers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "config"],
        "properties": {
          "name": {"type": "string"},
          "config": {"type": "object"}
        }
      }
    },
    "test_placement": {"type": "string"},
    "shared_containers": {"type": "boolean"},
    "reuse_containers": {"type": "boolean"},
    "patch_ci": {"type": "boolean"},
    "ci_provider": {"type": "string", "enum": ["github-actions", "gitlab-ci", "jenkins", "circleci", "bitbucket", "azure-devops"]}
  }
}
