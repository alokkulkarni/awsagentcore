{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deployment Runbook Schema",
  "description": "Machine-readable structure and validation metadata for operational deployment runbooks.",
  "type": "object",
  "requiredSections": [
    "Document Control",
    "Overview",
    "Prerequisites",
    "Procedure Steps",
    "Troubleshooting Table",
    "Rollback Procedure",
    "Quick Reference",
    "Change Log"
  ],
  "documentControlFields": [
    "title",
    "runbook_id",
    "version",
    "status",
    "owner",
    "created",
    "last_reviewed",
    "last_tested"
  ],
  "troubleshootingColumns": [
    "symptom",
    "probable_cause",
    "diagnostic_command",
    "resolution",
    "escalate_if"
  ],
  "severityLevels": [
    "CRITICAL",
    "HIGH",
    "MEDIUM",
    "LOW"
  ],
  "validationRules": [
    {"id": "RNB-001", "section": "Document Control", "severity": "CRITICAL", "title": "Document Control block present"},
    {"id": "RNB-002", "section": "Document Control", "severity": "HIGH", "title": "Runbook ID follows RNB-XXX-NNN format"},
    {"id": "RNB-003", "section": "Document Control", "severity": "HIGH", "title": "Version field present"},
    {"id": "RNB-004", "section": "Document Control", "severity": "HIGH", "title": "Last-tested date present"},
    {"id": "RNB-005", "section": "Overview", "severity": "CRITICAL", "title": "Overview section present"},
    {"id": "RNB-006", "section": "Overview", "severity": "MEDIUM", "title": "SLA/SLO targets defined"},
    {"id": "RNB-007", "section": "Overview", "severity": "HIGH", "title": "On-call contact present"},
    {"id": "RNB-008", "section": "Prerequisites", "severity": "CRITICAL", "title": "Prerequisites section present"},
    {"id": "RNB-009", "section": "Prerequisites", "severity": "MEDIUM", "title": "At least one env var checklist item in Prerequisites"},
    {"id": "RNB-010", "section": "Procedure Steps", "severity": "CRITICAL", "title": "At least 3 numbered procedure steps"},
    {"id": "RNB-011", "section": "Procedure Steps", "severity": "CRITICAL", "title": "Each step has a code block (command)"},
    {"id": "RNB-012", "section": "Procedure Steps", "severity": "CRITICAL", "title": "Each step has a Verify block"},
    {"id": "RNB-013", "section": "Procedure Steps", "severity": "HIGH", "title": "Each step has a failure/escalation block"},
    {"id": "RNB-014", "section": "Troubleshooting Table", "severity": "HIGH", "title": "Troubleshooting table present"},
    {"id": "RNB-015", "section": "Troubleshooting Table", "severity": "MEDIUM", "title": "Troubleshooting table has at least 3 rows"},
    {"id": "RNB-016", "section": "Troubleshooting Table", "severity": "HIGH", "title": "Troubleshooting table has all 5 columns"},
    {"id": "RNB-017", "section": "Rollback Procedure", "severity": "CRITICAL", "title": "Rollback Procedure section present"},
    {"id": "RNB-018", "section": "Rollback Procedure", "severity": "HIGH", "title": "Rollback procedure has numbered steps"},
    {"id": "RNB-019", "section": "Quick Reference", "severity": "MEDIUM", "title": "Quick Reference section present"},
    {"id": "RNB-020", "section": "Change Log", "severity": "LOW", "title": "Change Log present"}
  ],
  "required": [
    "document_control",
    "overview",
    "prerequisites",
    "procedure_steps",
    "troubleshooting_table",
    "rollback_procedure",
    "quick_reference",
    "change_log"
  ],
  "properties": {
    "document_control": {"$ref": "#/$defs/documentControl"},
    "overview": {"$ref": "#/$defs/overview"},
    "prerequisites": {"$ref": "#/$defs/prerequisites"},
    "procedure_steps": {
      "type": "array",
      "minItems": 3,
      "items": {"$ref": "#/$defs/step"}
    },
    "troubleshooting_table": {
      "type": "array",
      "minItems": 3,
      "items": {"$ref": "#/$defs/troubleshootingItem"}
    },
    "rollback_procedure": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/step"}
    },
    "quick_reference": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "change_log": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/changeLogEntry"}
    }
  },
  "$defs": {
    "documentControl": {
      "type": "object",
      "required": ["title", "runbook_id", "version", "status", "owner", "created", "last_reviewed", "last_tested"],
      "properties": {
        "title": {"type": "string", "minLength": 3},
        "runbook_id": {"type": "string", "pattern": "^RNB-[A-Z0-9]{3}-\\d{3}$"},
        "version": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "created": {"type": "string", "format": "date"},
        "last_reviewed": {"type": "string", "format": "date"},
        "last_tested": {"type": "string", "format": "date"}
      },
      "additionalProperties": true
    },
    "overview": {
      "type": "object",
      "required": ["component", "purpose", "critical_dependencies", "sla_slo_targets", "on_call_contact"],
      "properties": {
        "component": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "critical_dependencies": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "sla_slo_targets": {"type": "string", "minLength": 1},
        "on_call_contact": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "prerequisites": {
      "type": "object",
      "required": ["access", "tools", "permissions", "environment_variables", "pre_checks"],
      "properties": {
        "access": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "tools": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "permissions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "environment_variables": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/environmentVariable"}
        },
        "pre_checks": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": true
    },
    "environmentVariable": {
      "type": "object",
      "required": ["name", "purpose", "example"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
        "purpose": {"type": "string", "minLength": 1},
        "example": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "required": ["step_number", "title", "purpose", "command", "verify", "failure_action"],
      "properties": {
        "step_number": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "command": {"type": "string", "minLength": 1},
        "verify": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "failure_action": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": true
    },
    "troubleshootingItem": {
      "type": "object",
      "required": ["symptom", "probable_cause", "diagnostic_command", "resolution", "escalate_if"],
      "properties": {
        "symptom": {"type": "string", "minLength": 1},
        "probable_cause": {"type": "string", "minLength": 1},
        "diagnostic_command": {"type": "string", "minLength": 1},
        "resolution": {"type": "string", "minLength": 1},
        "escalate_if": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "changeLogEntry": {
      "type": "object",
      "required": ["version", "date", "author", "summary"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "date": {"type": "string", "format": "date"},
        "author": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
