# Amazon Connect Chat Tester — Environment Variable Reference
# Copy this file to .env and fill in your values.
# .env is gitignored; this file is safe to commit.

# ── Amazon Connect ────────────────────────────────────────────────────────────
AWS_REGION=eu-west-2
CONNECT_INSTANCE_ID=<your-connect-instance-uuid>
CONNECT_CONTACT_FLOW_ID=arn:aws:connect:REGION:ACCOUNT:instance/INSTANCE_ID/contact-flow/FLOW_ID

# ── Zephyr Squad (set ZEPHYR_ENABLED=true to activate) ───────────────────────
ZEPHYR_ENABLED=false
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_USERNAME=automation@yourcompany.com
JIRA_API_TOKEN=<jira-api-token>
JIRA_PROJECT_ID=<numeric-project-id>
JIRA_PROJECT_KEY=BANK
ZEPHYR_CYCLE_ID=<numeric-cycle-id>

# ── Test execution tuning ─────────────────────────────────────────────────────
CHAT_TIMEOUT_SECONDS=10
CHAT_DURATION_MINUTES=5
CHAT_POLL_INTERVAL_SECONDS=1
CHAT_MAX_POLL_ATTEMPTS=20
SCENARIOS_DIR=scenarios
REPORT_OUTPUT_DIR=reports
