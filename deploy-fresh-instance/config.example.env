# deploy-fresh-instance settings. Copy to e.g. my-instance.env, fill in, then:
#   ./deploy.sh --config my-instance.env
# Never commit your copy if you add anything private to it; IDs and secrets go to state/ (git-ignored), not here.

# The NEW account's AWS CLI profile (sign in first: aws sso login --profile ...). The script refuses the account
# today's system runs in.
AWS_PROFILE=aria-fresh

# Region for everything. eu-west-2 matches today's system (the AI models below are EU inference profiles).
REGION=eu-west-2

# The new instance's alias: its URL becomes https://<alias>.my.connect.aws, and several buckets are named after it.
# 4-38 lowercase letters, digits and hyphens, starting with a letter. Must not exist yet.
INSTANCE_ALIAS=aria-banking-demo

# A checkout of connect-livesync-mortgage (the mortgage Live Sync backend is deployed from there).
MORTGAGE_REPO=$HOME/Downloads/connect-livesync-mortgage

# A checkout of branchtransfercalldesign (ARIA's branch finder and appointment tools, and agent assist's queue-status
# tool, are deployed from its backend/).
BRANCH_REPO=$HOME/Documents/Development/branchtransfercalldesign

# Optional ---------------------------------------------------------------------------------------------------------
# The banking app's "how it works" demo overlay to start with (on|off; change later without a redeploy, see
# connect-banking-app/README).
FLOW_VIEW=off

# The level of assurance a matching caller number gives on calls (as today's injector: 3).
CLI_MATCH_LOA=3

# The designer apps' names as captured (templates/acxd/index.json lists them).
# ACXD_MORTGAGE_APP_NAME="Mortgage application"
# ACXD_DISPUTE_APP_NAME="Card dispute"

# AI models, if you deploy outside the EU (the defaults are EU / global inference profiles).
# ARIA_MODEL_ID=eu.anthropic.claude-sonnet-4-5-20250929-v1:0
# AGENT_ASSIST_MODEL_ID=global.anthropic.claude-sonnet-5
# BRIEFING_MODEL_ID=eu.anthropic.claude-haiku-4-5-20251001-v1:0
