{
  "Version": "2019-10-30",
  "StartAction": "EnableLogging",
  "Metadata": {
    "entryPointPosition": {
      "x": 40,
      "y": 200
    },
    "ActionMetadata": {
      "EnableLogging": {
        "position": {
          "x": 200,
          "y": 200
        }
      },
      "CheckTopic": {
        "position": {
          "x": 440,
          "y": 200
        }
      },
      "HandoffView": {
        "position": {
          "x": 700,
          "y": 320
        }
      },
      "MortgageApplicationView": {
        "position": {
          "x": 700,
          "y": 60
        }
      },
      "CheckButton": {
        "position": {
          "x": 960,
          "y": 200
        }
      },
      "End": {
        "position": {
          "x": 1220,
          "y": 200
        }
      }
    },
    "Annotations": [],
    "name": "ARIA-Agent-Screen-Pop-Flow",
    "description": "Agent screen pop: ARIA handoff summary and the assistant's arrival briefing.",
    "type": "contactFlow",
    "status": "saved"
  },
  "Actions": [
    {
      "Identifier": "EnableLogging",
      "Type": "UpdateFlowLoggingBehavior",
      "Parameters": {
        "FlowLoggingBehavior": "Enabled"
      },
      "Transitions": {
        "NextAction": "CheckTopic"
      }
    },
    {
      "Identifier": "CheckTopic",
      "Type": "Compare",
      "Parameters": {
        "ComparisonValue": "$.Attributes.topicCategory"
      },
      "Transitions": {
        "NextAction": "HandoffView",
        "Conditions": [
          {
            "NextAction": "MortgageApplicationView",
            "Condition": {
              "Operator": "Equals",
              "Operands": [
                "mortgage_application"
              ]
            }
          }
        ],
        "Errors": [
          {
            "NextAction": "HandoffView",
            "ErrorType": "NoMatchingCondition"
          }
        ]
      }
    },
    {
      "Identifier": "HandoffView",
      "Type": "ShowView",
      "Parameters": {
        "ViewResource": {
          "Id": "arn:aws:connect:eu-west-2:aws:view/detail:1"
        },
        "InvocationTimeLimitSeconds": "600",
        "ViewData": {
          "Heading": "ARIA Handoff Summary",
          "Sections": [
            {
              "Items": [
                {
                  "Label": "Customer Intent",
                  "Value": "$.Attributes.ariaCustomerIntent"
                },
                {
                  "Label": "Escalation Reason",
                  "Value": "$.Attributes.ariaEscalationReason"
                },
                {
                  "Label": "Summary",
                  "Value": "$.Attributes.ariaSummary"
                }
              ]
            },
            {
              "Items": [
                {
                  "Label": "Do first",
                  "Value": "$.Attributes.assistBriefFirst"
                },
                {
                  "Label": "Verification",
                  "Value": "$.Attributes.assistBriefVerification"
                },
                {
                  "Label": "Likely reasons",
                  "Value": "$.Attributes.assistBriefReasons"
                },
                {
                  "Label": "Product details",
                  "Value": "$.Attributes.assistBriefProduct"
                },
                {
                  "Label": "Related guidance",
                  "Value": "$.Attributes.assistBriefGuidance"
                }
              ]
            }
          ],
          "Actions": [
            "Refresh briefing",
            "Got it"
          ]
        }
      },
      "Transitions": {
        "NextAction": "End",
        "Conditions": [
          {
            "NextAction": "CheckButton",
            "Condition": {
              "Operator": "Equals",
              "Operands": [
                "ActionSelected"
              ]
            }
          },
          {
            "NextAction": "End",
            "Condition": {
              "Operator": "Equals",
              "Operands": [
                "Back"
              ]
            }
          }
        ],
        "Errors": [
          {
            "NextAction": "End",
            "ErrorType": "NoMatchingCondition"
          },
          {
            "NextAction": "End",
            "ErrorType": "NoMatchingError"
          },
          {
            "NextAction": "End",
            "ErrorType": "TimeLimitExceeded"
          }
        ]
      }
    },
    {
      "Identifier": "MortgageApplicationView",
      "Type": "ShowView",
      "Parameters": {
        "ViewResource": {
          "Id": "arn:aws:connect:eu-west-2:aws:view/detail:1"
        },
        "InvocationTimeLimitSeconds": "600",
        "ViewData": {
          "Heading": "Mortgage application",
          "AttributeBar": [
            {
              "Label": "Application ID",
              "Value": "$.Attributes.applicationId",
              "Copyable": true
            },
            {
              "Label": "Stage reached",
              "Value": "$.Attributes.stage"
            },
            {
              "Label": "Decision in Principle",
              "Value": "$.Attributes.dipDecision"
            },
            {
              "Label": "Product selected",
              "Value": "$.Attributes.productId"
            },
            {
              "Label": "Documents outstanding",
              "Value": "$.Attributes.docsOutstanding"
            }
          ],
          "Sections": [
            {
              "TemplateString": "**Arrived via:** $.Attributes.entry ($.Channel)"
            },
            {
              "TemplateString": "**Why transferred:** $.Attributes.ariaEscalationReason"
            },
            {
              "TemplateString": "$.Attributes.ariaSummary"
            },
            {
              "Items": [
                {
                  "Label": "Do first",
                  "Value": "$.Attributes.assistBriefFirst"
                },
                {
                  "Label": "Verification",
                  "Value": "$.Attributes.assistBriefVerification"
                },
                {
                  "Label": "Likely reasons",
                  "Value": "$.Attributes.assistBriefReasons"
                },
                {
                  "Label": "Product details",
                  "Value": "$.Attributes.assistBriefProduct"
                },
                {
                  "Label": "Related guidance",
                  "Value": "$.Attributes.assistBriefGuidance"
                }
              ]
            }
          ],
          "Actions": [
            "Refresh briefing",
            "Got it"
          ]
        }
      },
      "Transitions": {
        "NextAction": "End",
        "Conditions": [
          {
            "NextAction": "CheckButton",
            "Condition": {
              "Operator": "Equals",
              "Operands": [
                "ActionSelected"
              ]
            }
          },
          {
            "NextAction": "End",
            "Condition": {
              "Operator": "Equals",
              "Operands": [
                "Back"
              ]
            }
          }
        ],
        "Errors": [
          {
            "NextAction": "End",
            "ErrorType": "NoMatchingCondition"
          },
          {
            "NextAction": "End",
            "ErrorType": "NoMatchingError"
          },
          {
            "NextAction": "End",
            "ErrorType": "TimeLimitExceeded"
          }
        ]
      }
    },
    {
      "Identifier": "CheckButton",
      "Type": "Compare",
      "Parameters": {
        "ComparisonValue": "$.Views.Action"
      },
      "Transitions": {
        "NextAction": "End",
        "Conditions": [
          {
            "NextAction": "CheckTopic",
            "Condition": {
              "Operator": "Equals",
              "Operands": [
                "Refresh briefing"
              ]
            }
          }
        ],
        "Errors": [
          {
            "NextAction": "End",
            "ErrorType": "NoMatchingCondition"
          }
        ]
      }
    },
    {
      "Identifier": "End",
      "Type": "EndFlowExecution",
      "Parameters": {},
      "Transitions": {}
    }
  ]
}
