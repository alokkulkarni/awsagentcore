# =============================================================================
# aria-evaluator-ts — local generated output
# =============================================================================

# Evaluation reports (HTML + JSON) — generated at runtime, never commit
reports/

# Conversation transcripts (JSON) — may contain PII or sensitive test data
transcripts/

# Temporary portal run YAML files
.tmp/

# SQLite database — local only
data/*.db
data/*.db-shm
data/*.db-wal

# Build output
dist/

# Dependencies
node_modules/

# TypeScript incremental build info
*.tsbuildinfo
